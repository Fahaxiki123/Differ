<UserControl x:Class="Differ.App.SpreadsheetWorksheetDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Differ.App.Controls"
             xmlns:models="clr-namespace:Differ.Core.Models;assembly=Differ.Core"
             xmlns:resources="clr-namespace:Differ.App.Resources"
             Background="{DynamicResource PanelBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SpreadsheetCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.GridLine}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <!-- A fixed overlay preserves grid geometry and the cell's diff background. -->
                                <Border x:Name="SelectionOutline"
                                        BorderBrush="{DynamicResource SelectionBorderBrush}"
                                        BorderThickness="2" Opacity="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectionOutline" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SpreadsheetRowStyle" TargetType="DataGridRow">
                <Setter Property="Height" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Button Command="{Binding ExpandCommand}"
                                            Content="{Binding CollapsedLabel}"
                                            MinHeight="0"
                                            Background="{DynamicResource GutterBackgroundBrush}"
                                            Foreground="{DynamicResource MutedInkBrush}"
                                            BorderThickness="0" Padding="10,0"
                                            HorizontalContentAlignment="Left" FontSize="{StaticResource Ui.MetadataFontSize}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SpreadsheetColumnHeaderStyle"
                   TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Height" Value="{StaticResource Ui.SpreadsheetHeaderHeight}" />
                <Setter Property="Padding" Value="{StaticResource Ui.CellPadding}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource GutterBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GutterTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.GridLine}" />
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="{StaticResource Ui.MetadataFontSize}" />
            </Style>
            <DataTemplate x:Key="SpreadsheetColumnHeaderTemplate">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding HeaderText}" ToolTip="{Binding MappingToolTip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GutterTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDifferences}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Diff.Inline.Modified.Brush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <ContextMenu x:Key="SpreadsheetCellContextMenu">
                <MenuItem Click="CopyBaseSide_Click" Header="{x:Static resources:Strings.CopyBaseSide}" />
                <MenuItem Click="CopyMineSide_Click" Header="{x:Static resources:Strings.CopyMineSide}" />
                <Separator />
                <MenuItem Click="CopyBothSides_Click" Header="{x:Static resources:Strings.CopyBothSides}" />
                <Separator />
                <MenuItem Click="CopyBaseRow_Click" Header="{x:Static resources:Strings.CopyBaseRow}" />
                <MenuItem Click="CopyMineRow_Click" Header="{x:Static resources:Strings.CopyMineRow}" />
            </ContextMenu>
            <DataTemplate x:Key="BaseRowNumberTemplate">
                <Grid Background="{DynamicResource GutterBackgroundBrush}" ToolTip="{Binding KindLabel}">
                    <Border x:Name="StateMarker" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                    <TextBlock Margin="7,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource GutterTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource Ui.MetadataFontSize}" Text="{Binding BaseRowNumberText}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Added}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Added.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Deleted}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Deleted.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Modified}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Modified.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Moved}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Moved.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Conflict}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Conflict.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Unsupported}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Unsupported.Border}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="MineRowNumberTemplate">
                <Grid Background="{DynamicResource GutterBackgroundBrush}" ToolTip="{Binding KindLabel}">
                    <Border x:Name="StateMarker" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                    <TextBlock Margin="7,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource GutterTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource Ui.MetadataFontSize}" Text="{Binding MineRowNumberText}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Added}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Added.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Deleted}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Deleted.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Modified}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Modified.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Moved}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Moved.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Conflict}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Conflict.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Unsupported}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Unsupported.Border}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource Ui.DetailSplitterRowHeight}" />
            <RowDefinition Height="104" MinHeight="{StaticResource Ui.DetailHeaderHeight}" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ContentControl x:Name="BaseHeaderHost" Grid.Row="0" Grid.Column="0" />
            <ContentControl x:Name="MineHeaderHost" Grid.Row="0" Grid.Column="2" />
            <DataGrid x:Name="BaseSpreadsheetGrid" Grid.Row="1" Grid.Column="0"
                      AutoGenerateColumns="False" CanUserResizeColumns="False"
                      CanUserResizeRows="False" CanUserSortColumns="False"
                      CellStyle="{StaticResource SpreadsheetCellStyle}"
                      ClipboardCopyMode="None"
                      ColumnHeaderStyle="{StaticResource SpreadsheetColumnHeaderStyle}"
                      ContextMenu="{StaticResource SpreadsheetCellContextMenu}"
                      ContextMenuOpening="SpreadsheetGrid_ContextMenuOpening"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      FrozenColumnCount="{Binding FrozenColumnCount}" GridLinesVisibility="None" HeadersVisibility="Column"
                      ItemsSource="{Binding ScrollableRows}" Loaded="SpreadsheetGrid_Loaded"
                      PreviewKeyDown="SpreadsheetGrid_PreviewKeyDown"
                      RowStyle="{StaticResource SpreadsheetRowStyle}"
                      SelectedCellsChanged="SpreadsheetGrid_SelectedCellsChanged"
                      SelectionMode="Single" SelectionUnit="Cell"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns><DataGridTemplateColumn Width="50" CellTemplate="{StaticResource BaseRowNumberTemplate}" Header="" /></DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource PaneSeparatorBrush}" />
            <DataGrid x:Name="MineSpreadsheetGrid" Grid.Row="1" Grid.Column="2"
                      AutoGenerateColumns="False" CanUserResizeColumns="False"
                      CanUserResizeRows="False" CanUserSortColumns="False"
                      CellStyle="{StaticResource SpreadsheetCellStyle}"
                      ClipboardCopyMode="None"
                      ColumnHeaderStyle="{StaticResource SpreadsheetColumnHeaderStyle}"
                      ContextMenu="{StaticResource SpreadsheetCellContextMenu}"
                      ContextMenuOpening="SpreadsheetGrid_ContextMenuOpening"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      FrozenColumnCount="{Binding FrozenColumnCount}" GridLinesVisibility="None" HeadersVisibility="Column"
                      ItemsSource="{Binding ScrollableRows}" Loaded="SpreadsheetGrid_Loaded"
                      PreviewKeyDown="SpreadsheetGrid_PreviewKeyDown"
                      RowStyle="{StaticResource SpreadsheetRowStyle}"
                      SelectedCellsChanged="SpreadsheetGrid_SelectedCellsChanged"
                      SelectionMode="Single" SelectionUnit="Cell"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns><DataGridTemplateColumn Width="50" CellTemplate="{StaticResource MineRowNumberTemplate}" Header="" /></DataGrid.Columns>
            </DataGrid>
        </Grid>
        <GridSplitter x:Name="DetailSplitter" Grid.Row="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" Visibility="Visible"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Divider" Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource PaneHeaderBorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Grid Grid.Row="2" Background="{DynamicResource DetailBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource Ui.DetailHeaderRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="DetailsToggle" Grid.Row="0"
                          Style="{StaticResource DetailToggleStyle}" IsChecked="True"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{x:Static resources:Strings.SelectedContentDetails}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedInkBrush}"
                               Text="{x:Static resources:Strings.SelectedContentDetails}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource MutedInkBrush}" Text="{x:Static resources:Strings.BaseSide}" />
                        <TextBlock Margin="6,0,12,0" Foreground="{DynamicResource MutedInkBrush}"
                                   FontFamily="Cascadia Mono, Consolas" Text="{Binding SelectedCell.BaseAddress}" />
                        <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource MutedInkBrush}" Text="↔" />
                        <TextBlock Foreground="{DynamicResource MutedInkBrush}" Text="{x:Static resources:Strings.MineSide}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource MutedInkBrush}"
                                   FontFamily="Cascadia Mono, Consolas" Text="{Binding SelectedCell.MineAddress}" />
                    </StackPanel>
                </DockPanel>
            </ToggleButton>
            <Grid x:Name="DetailsContent" Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="{StaticResource Ui.DetailContentPadding}">
                    <controls:SelectableDiffTextBox
                        DiffKind="{Binding SelectedCell.Kind}"
                        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="{StaticResource Ui.SpreadsheetFontSize}"
                        Foreground="{DynamicResource InkBrush}"
                        AutomationProperties.Name="{x:Static resources:Strings.FullBaseContent}"
                        Segments="{Binding SelectedCell.BaseSegments}" />
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource PaneHeaderBorderBrush}" />
                <Border Grid.Column="2" Padding="{StaticResource Ui.DetailContentPadding}">
                    <controls:SelectableDiffTextBox
                        DiffKind="{Binding SelectedCell.Kind}"
                        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="{StaticResource Ui.SpreadsheetFontSize}"
                        Foreground="{DynamicResource InkBrush}"
                        AutomationProperties.Name="{x:Static resources:Strings.FullCurrentContent}"
                        Segments="{Binding SelectedCell.MineSegments}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
