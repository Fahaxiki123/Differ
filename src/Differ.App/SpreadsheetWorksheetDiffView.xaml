<UserControl x:Class="Differ.App.SpreadsheetWorksheetDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Differ.App.Controls"
             xmlns:models="clr-namespace:Differ.Core.Models;assembly=Differ.Core"
             xmlns:resources="clr-namespace:Differ.App.Resources"
             Background="{DynamicResource PanelBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SpreadsheetCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.GridLine}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <controls:SpreadsheetCellFrame x:Name="CellFrame" SnapsToDevicePixels="True" ClipToBounds="True"
                                                           Background="{TemplateBinding Background}"
                                                           BorderBrush="{TemplateBinding BorderBrush}"
                                                           BorderThickness="{TemplateBinding BorderThickness}"
                                                           Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </controls:SpreadsheetCellFrame>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CellFrame" Property="SelectionBrush" Value="{DynamicResource Dui.Focus}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SpreadsheetRowStyle" TargetType="DataGridRow">
                <Setter Property="Height" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="MinHeight" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="MaxHeight" Value="{StaticResource Ui.SpreadsheetRowHeight}" />
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Button Command="{Binding ExpandCommand}"
                                            Content="{Binding CollapsedLabel}"
                                            MinHeight="0"
                                            Background="{DynamicResource GutterBackgroundBrush}"
                                            Foreground="{DynamicResource MutedInkBrush}"
                                            BorderThickness="0" Padding="10,0"
                                            HorizontalContentAlignment="Left" FontSize="{StaticResource Ui.MetadataFontSize}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SpreadsheetColumnHeaderStyle"
                   TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Height" Value="{StaticResource Ui.SpreadsheetHeaderHeight}" />
                <Setter Property="Padding" Value="{StaticResource Ui.CellPadding}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource Dui.Surface.Tabs}" />
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
                <Setter Property="FontFamily" Value="{StaticResource Dui.Metrics.UiFont}" />
                <Setter Property="FontSize" Value="{StaticResource Ui.MetadataFontSize}" />
            </Style>
            <DataTemplate x:Key="SpreadsheetColumnHeaderTemplate">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding HeaderText}" ToolTip="{Binding MappingToolTip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDifferences}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Diff.Inline.Modified.Brush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <ContextMenu x:Key="SpreadsheetCellContextMenu" Style="{StaticResource Dui.ContextMenu}">
                <MenuItem Click="CopyBaseSide_Click" Header="{x:Static resources:Strings.CopyBaseSide}" />
                <MenuItem Click="CopyMineSide_Click" Header="{x:Static resources:Strings.CopyMineSide}" />
                <Separator />
                <MenuItem Click="CopyBothSides_Click" Header="{x:Static resources:Strings.CopyBothSides}" />
                <Separator />
                <MenuItem Click="CopyBaseRow_Click" Header="{x:Static resources:Strings.CopyBaseRow}" />
                <MenuItem Click="CopyMineRow_Click" Header="{x:Static resources:Strings.CopyMineRow}" />
            </ContextMenu>
            <DataTemplate x:Key="BaseRowNumberTemplate">
                <Grid Background="{DynamicResource Dui.Surface.PaneHeader}" ToolTip="{Binding KindLabel}">
                    <Border x:Name="StateMarker" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                    <TextBlock Margin="7,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Dui.Text.Secondary}" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource Ui.MetadataFontSize}" Text="{Binding BaseRowNumberText}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Added}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Added.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Deleted}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Deleted.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Modified}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Modified.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Moved}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Moved.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Conflict}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Conflict.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Unsupported}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Unsupported.Border}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="MineRowNumberTemplate">
                <Grid Background="{DynamicResource Dui.Surface.PaneHeader}" ToolTip="{Binding KindLabel}">
                    <Border x:Name="StateMarker" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                    <TextBlock Margin="7,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Dui.Text.Secondary}" FontFamily="Cascadia Mono, Consolas" FontSize="{StaticResource Ui.MetadataFontSize}" Text="{Binding MineRowNumberText}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Added}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Added.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Deleted}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Deleted.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Modified}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Modified.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Moved}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Moved.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Conflict}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Conflict.Border}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:DiffKind.Unsupported}"><Setter TargetName="StateMarker" Property="Background" Value="{DynamicResource Diff.Row.Unsupported.Border}" /></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="BaseHeaderHost" Grid.Row="0" Grid.Column="0" />
        <ContentControl x:Name="MineHeaderHost" Grid.Row="0" Grid.Column="2" />
        <DataGrid x:Name="BaseSpreadsheetGrid" Grid.Row="1" Grid.Column="0"
                  AutomationProperties.Name="{x:Static resources:Strings.BaseSide}"
                  AutoGenerateColumns="False" CanUserResizeColumns="False"
                  CanUserResizeRows="False" CanUserSortColumns="False"
                  CellStyle="{StaticResource SpreadsheetCellStyle}"
                  ClipboardCopyMode="None"
                  ColumnHeaderStyle="{StaticResource SpreadsheetColumnHeaderStyle}"
                  ContextMenu="{StaticResource SpreadsheetCellContextMenu}"
                  ContextMenuOpening="SpreadsheetGrid_ContextMenuOpening"
                  EnableColumnVirtualization="True" EnableRowVirtualization="True"
                  FrozenColumnCount="{Binding FrozenColumnCount}" GridLinesVisibility="None" HeadersVisibility="Column"
                  ItemsSource="{Binding ScrollableRows}" Loaded="SpreadsheetGrid_Loaded"
                  PreviewKeyDown="SpreadsheetGrid_PreviewKeyDown"
                  RowStyle="{StaticResource SpreadsheetRowStyle}" RowHeight="{StaticResource Ui.SpreadsheetRowHeight}"
                  SelectedCellsChanged="SpreadsheetGrid_SelectedCellsChanged"
                  SelectionMode="Single" SelectionUnit="Cell"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.CacheLength="0"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns><DataGridTemplateColumn Width="50" CellTemplate="{StaticResource BaseRowNumberTemplate}" Header="" /></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Dui.Border.Subtle}" />
        <DataGrid x:Name="MineSpreadsheetGrid" Grid.Row="1" Grid.Column="2"
                  AutomationProperties.Name="{x:Static resources:Strings.MineSide}"
                  AutoGenerateColumns="False" CanUserResizeColumns="False"
                  CanUserResizeRows="False" CanUserSortColumns="False"
                  CellStyle="{StaticResource SpreadsheetCellStyle}"
                  ClipboardCopyMode="None"
                  ColumnHeaderStyle="{StaticResource SpreadsheetColumnHeaderStyle}"
                  ContextMenu="{StaticResource SpreadsheetCellContextMenu}"
                  ContextMenuOpening="SpreadsheetGrid_ContextMenuOpening"
                  EnableColumnVirtualization="True" EnableRowVirtualization="True"
                  FrozenColumnCount="{Binding FrozenColumnCount}" GridLinesVisibility="None" HeadersVisibility="Column"
                  ItemsSource="{Binding ScrollableRows}" Loaded="SpreadsheetGrid_Loaded"
                  PreviewKeyDown="SpreadsheetGrid_PreviewKeyDown"
                  RowStyle="{StaticResource SpreadsheetRowStyle}" RowHeight="{StaticResource Ui.SpreadsheetRowHeight}"
                  SelectedCellsChanged="SpreadsheetGrid_SelectedCellsChanged"
                  SelectionMode="Single" SelectionUnit="Cell"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.CacheLength="0"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns><DataGridTemplateColumn Width="50" CellTemplate="{StaticResource MineRowNumberTemplate}" Header="" /></DataGrid.Columns>
        </DataGrid>
        <controls:SpreadsheetDragSurface x:Name="DragSurface" Grid.RowSpan="2" Grid.ColumnSpan="3"
                                         IsHitTestVisible="False" Focusable="False" />
        <controls:SpreadsheetScrollRail x:Name="VerticalRail" Grid.Row="1" Grid.Column="3"
                                        Visibility="Hidden" HorizontalAlignment="Right" UseLayoutRounding="False"
                                        AutomationProperties.Name="{x:Static resources:Strings.OverviewLabel}"
                                        FocusVisualStyle="{StaticResource Dui.KeyboardFocus}"
                                        ReadingScale="{Binding DataContext.Preferences.ReadingScale, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=1}" />
        <Popup x:Name="RailPreviewPopup" Placement="Left" PlacementTarget="{Binding ElementName=VerticalRail}"
               HorizontalOffset="-5" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False" Focusable="False">
            <Grid Width="380" Margin="8">
                <Border Background="{DynamicResource Diff.Overview.PreviewBrush}" CornerRadius="{StaticResource Ui.PopupCornerRadius}"
                        Effect="{StaticResource FloatingPanelShadow}" />
                <Border Background="{DynamicResource Diff.Overview.PreviewBrush}" BorderBrush="{DynamicResource Diff.Overview.PreviewBorderBrush}"
                        Padding="{StaticResource Ui.PopupPadding}" CornerRadius="{StaticResource Ui.PopupCornerRadius}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="RailPreviewKind" DockPanel.Dock="Right" Foreground="{DynamicResource MutedInkBrush}" />
                            <TextBlock x:Name="RailPreviewAddress" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static resources:Strings.OverviewBase}" FontWeight="SemiBold" Foreground="{DynamicResource BaseSideAccentBrush}" />
                                <TextBlock x:Name="RailBasePreview" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="70" Foreground="{DynamicResource InkBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource Diff.Overview.PreviewBorderBrush}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static resources:Strings.OverviewMine}" FontWeight="SemiBold" Foreground="{DynamicResource MineSideAccentBrush}" />
                                <TextBlock x:Name="RailMinePreview" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="70" Foreground="{DynamicResource InkBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
