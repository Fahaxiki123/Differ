<UserControl x:Class="Differ.App.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:resources="clr-namespace:Differ.App.Resources"
             Loaded="OnLoaded" SizeChanged="OnHeaderSizeChanged" Background="{DynamicResource Sample.SurfaceBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Sample.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Sample.PaneHeaderRowHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="EditorPaneHeaders" Background="{DynamicResource Sample.PaneHeaderBrush}"
                BorderBrush="{DynamicResource Sample.BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="BasePaneHeader" Margin="8,0">
                    <Grid.ToolTip>
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="{Binding BaseTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BasePath}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BaseRevisionText}" />
                        </StackPanel>
                    </Grid.ToolTip>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorBaseIdentity}" Foreground="{DynamicResource InkBrush}"
                               FontSize="{StaticResource Sample.PaneTitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{x:Static resources:ChromeStrings.ReadOnly}"
                               Foreground="{DynamicResource MutedInkBrush}" FontSize="{StaticResource Ui.MetadataFontSize}" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Column="1" BorderBrush="{DynamicResource PaneSeparatorBrush}" BorderThickness="1,0" />
                <Grid x:Name="MinePaneHeader" Grid.Column="2" Margin="8,0">
                    <Grid.ToolTip>
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="{Binding MineTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MinePath}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MineRevisionText}" />
                            <TextBlock Text="{Binding EditorPermissionText}" />
                            <TextBlock Text="{Binding EditorSaveStatus}" />
                        </StackPanel>
                    </Grid.ToolTip>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,6,0" VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock x:Name="MineSaveStatus" DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding EditorSaveStatus}"
                               Foreground="{DynamicResource Sample.MutedInkBrush}" FontSize="{StaticResource Ui.MetadataFontSize}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorMineIdentity}" Foreground="{DynamicResource InkBrush}"
                               FontSize="{StaticResource Sample.PaneTitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel x:Name="EditorActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource Sample.ToolbarButton}" Width="24" MinWidth="24" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE7A7;"
                                Command="{Binding UndoEditorCommand}" IsEnabled="{Binding CanEditorUndo}"
                                AutomationProperties.Name="{x:Static resources:Strings.EditorUndo}" ToolTip="{x:Static resources:ChromeStrings.UndoShortcut}" />
                        <Button x:Name="RedoButton" Style="{StaticResource Sample.ToolbarButton}" Width="24" MinWidth="24" Padding="0" Margin="2,0,4,0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE7A6;"
                                Command="{Binding RedoEditorCommand}" IsEnabled="{Binding CanEditorRedo}"
                                AutomationProperties.Name="{x:Static resources:Strings.EditorRedo}" ToolTip="{x:Static resources:ChromeStrings.RedoShortcut}" />
                        <ToggleButton x:Name="EditModeToggle" Style="{StaticResource Sample.EditModeToggle}" Margin="0,0,6,0"
                                      Content="{Binding EditorPermissionText}" IsChecked="{Binding IsEditMode, Mode=OneWay}" Command="{Binding ToggleEditModeCommand}"
                                      AutomationProperties.Name="{x:Static resources:ChromeStrings.EditMode}" ToolTip="{x:Static resources:ChromeStrings.EditModeHint}" />
                        <Border CornerRadius="{StaticResource Ui.ButtonCornerRadius}" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveButton" Style="{StaticResource Sample.PrimaryButton}" MinWidth="56" Padding="6,0"
                                        Command="{Binding SaveEditorCommand}" IsEnabled="{Binding CanEditorSave}"
                                        ToolTip="{x:Static resources:ChromeStrings.SaveShortcut}" AutomationProperties.Name="{Binding EditorSaveActionLabel}">
                                    <TextBlock Text="{Binding EditorSaveActionLabel}" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="SaveMenuButton" Style="{StaticResource Sample.PrimaryButton}" Width="18" MinWidth="18" Padding="0" FontSize="9"
                                        Click="SaveOptions_Click" IsEnabled="{Binding CanEditorSaveAs}"
                                        ToolTip="{x:Static resources:ChromeStrings.SaveOptions}" AutomationProperties.Name="{x:Static resources:ChromeStrings.SaveOptions}">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{x:Static resources:Strings.EditorSaveAs}" InputGestureText="Ctrl+Shift+S"
                                                      Command="{Binding SaveEditorAsCommand}" IsEnabled="{Binding CanEditorSaveAs}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <wv:WebView2 x:Name="Browser" Grid.Row="2" />
        <TextBlock x:Name="StartupStatus" Grid.Row="1" Text="{x:Static resources:Strings.EditorStarting}" Margin="18"
                   TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
</UserControl>
