<UserControl x:Class="Differ.App.CodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:dui="clr-namespace:Differ.UI.Controls;assembly=Differ.UI"
             xmlns:resources="clr-namespace:Differ.App.Resources"
             Loaded="OnLoaded" SizeChanged="OnHeaderSizeChanged" Background="{DynamicResource Dui.Surface.Content}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Dui.Surface.Content}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Dui.Metrics.PaneHeaderRowHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="EditorPaneHeaders" Style="{StaticResource Dui.PaneHeader}"
                Background="{DynamicResource Dui.Surface.Content}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="BasePaneHeader" Margin="8,0">
                    <Grid.ToolTip>
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="{Binding BaseTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BasePath}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BaseRevisionText}" />
                        </StackPanel>
                    </Grid.ToolTip>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EditorBaseIdentity}" Foreground="{DynamicResource Dui.Text.Primary}"
                               FontSize="{StaticResource Dui.Metrics.BodyFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2"
                            Background="{DynamicResource Dui.State.ReadOnly}" VerticalAlignment="Center"
                            CornerRadius="{StaticResource Dui.Metrics.SmallRadius}">
                        <TextBlock Text="{x:Static resources:ChromeStrings.ReadOnly}"
                                   Foreground="{DynamicResource Dui.Text.Secondary}" FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}" />
                    </Border>
                </Grid>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Dui.Border.Subtle}" BorderThickness="1,0" />
                <Grid x:Name="MinePaneHeader" Grid.Column="2" Margin="8,0">
                    <Grid.ToolTip>
                        <StackPanel MaxWidth="700">
                            <TextBlock Text="{Binding MineTitle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MinePath}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MineRevisionText}" />
                            <TextBlock Text="{Binding EditorPermissionText}" />
                            <TextBlock Text="{Binding EditorSaveStatus}" />
                        </StackPanel>
                    </Grid.ToolTip>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,6,0" VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock x:Name="MineSaveStatus" DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding EditorSaveStatus}"
                               Foreground="{DynamicResource Dui.Text.Secondary}" FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EditorMineIdentity}" Foreground="{DynamicResource Dui.Text.Primary}"
                               FontSize="{StaticResource Dui.Metrics.BodyFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel x:Name="EditorActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Style="{StaticResource Dui.Button.Icon}" Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                Command="{Binding UndoEditorCommand}" IsEnabled="{Binding CanEditorUndo}"
                                AutomationProperties.Name="{x:Static resources:Strings.EditorUndo}" ToolTip="{x:Static resources:ChromeStrings.UndoShortcut}">
                            <dui:AppIcon Kind="Undo" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource Dui.Button.Icon}" Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}" Margin="2,0,4,0"
                                Command="{Binding RedoEditorCommand}" IsEnabled="{Binding CanEditorRedo}"
                                AutomationProperties.Name="{x:Static resources:Strings.EditorRedo}" ToolTip="{x:Static resources:ChromeStrings.RedoShortcut}">
                            <dui:AppIcon Kind="Redo" />
                        </Button>
                        <ToggleButton x:Name="EditModeToggle" Style="{StaticResource Dui.Toggle.Switch}" Margin="0,0,6,0"
                                      Content="{Binding EditorPermissionText}" IsChecked="{Binding IsEditMode, Mode=OneWay}" Command="{Binding ToggleEditModeCommand}"
                                      AutomationProperties.Name="{x:Static resources:ChromeStrings.EditMode}" ToolTip="{x:Static resources:ChromeStrings.EditModeHint}" />
                        <Border CornerRadius="{StaticResource Dui.Metrics.ControlRadius}" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveButton" Style="{StaticResource Dui.Button.Primary}" MinWidth="56"
                                        MinHeight="{StaticResource Dui.Metrics.ToolbarButtonHeight}" Padding="8,0"
                                        Command="{Binding SaveEditorCommand}" IsEnabled="{Binding CanEditorSave}"
                                        ToolTip="{x:Static resources:ChromeStrings.SaveShortcut}" AutomationProperties.Name="{Binding EditorSaveActionLabel}">
                                    <TextBlock Text="{Binding EditorSaveActionLabel}" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="SaveMenuButton" Style="{StaticResource Dui.Button.Primary}"
                                        Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}" MinWidth="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                        MinHeight="{StaticResource Dui.Metrics.ToolbarButtonHeight}" Margin="1,0,0,0" Padding="0"
                                        Click="SaveOptions_Click" IsEnabled="{Binding CanEditorSaveAs}"
                                        ToolTip="{x:Static resources:ChromeStrings.SaveOptions}" AutomationProperties.Name="{x:Static resources:ChromeStrings.SaveOptions}">
                                    <dui:AppIcon Kind="ChevronDown"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource Dui.ContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{x:Static resources:Strings.EditorSaveAs}" InputGestureText="Ctrl+Shift+S"
                                                      Command="{Binding SaveEditorAsCommand}" IsEnabled="{Binding CanEditorSaveAs}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <wv:WebView2 x:Name="Browser" Grid.Row="2" />
        <TextBlock x:Name="StartupStatus" Grid.Row="1" Text="{x:Static resources:Strings.EditorStarting}" Margin="18"
                   TextWrapping="Wrap" Foreground="{DynamicResource Dui.Text.Primary}" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
</UserControl>
