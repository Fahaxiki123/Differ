<Window x:Class="Differ.App.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dui="clr-namespace:Differ.UI.Controls;assembly=Differ.UI"
        xmlns:controls="clr-namespace:Differ.App.Controls"
        xmlns:local="clr-namespace:Differ.App"
        xmlns:resources="clr-namespace:Differ.App.Resources"
        Title="{Binding WindowTitle}"
        Icon="Assets/Differ.ico"
        Width="1500"
        Height="860"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="FileTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,2,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Secondary}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
                <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.SecondaryFontSize}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TabChrome"
                                    MinWidth="128"
                                    MaxWidth="300"
                                    MinHeight="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                    Padding="8,0,2,0"
                                    Background="{DynamicResource Dui.Surface.Tabs}"
                                    BorderBrush="{DynamicResource Dui.Surface.Tabs}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="{StaticResource Dui.Metrics.TabRadius}">
                                <Grid>
                                    <Border x:Name="ActiveTabIndicator" Width="2" Height="14"
                                            Margin="-4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource Dui.Accent}" CornerRadius="{StaticResource Dui.Metrics.SmallRadius}"
                                            Visibility="Collapsed" IsHitTestVisible="False" />
                                    <ContentPresenter Margin="3,0,0,0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Dui.State.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ActiveTabIndicator" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Dui.Surface.Content}" />
                                    <Setter TargetName="TabChrome"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Dui.Border.Subtle}" />
                                    <Setter TargetName="TabChrome"
                                            Property="BorderThickness"
                                            Value="1,1,1,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <DataTemplate x:Key="SpreadsheetFormatTemplate">
                <local:SpreadsheetDiffView />
            </DataTemplate>
            <DataTemplate x:Key="TextFormatTemplate">
                <local:TextDiffView />
            </DataTemplate>
            <DataTemplate x:Key="EditableTextFormatTemplate">
                <local:CodeEditorView ReadingScale="{Binding DataContext.Preferences.ReadingScale, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataTemplate>
            <DataTemplate x:Key="WordFormatTemplate">
                <local:WordDiffView />
            </DataTemplate>
            <controls:ComparisonViewTemplateSelector
                x:Key="ComparisonViewTemplateSelector"
                SpreadsheetTemplate="{StaticResource SpreadsheetFormatTemplate}"
                StandardTemplate="{StaticResource TextFormatTemplate}"
                TextTemplate="{StaticResource TextFormatTemplate}"
                WordTemplate="{StaticResource WordFormatTemplate}" />

            <DataTemplate x:Key="ComparisonContentTemplate">
                <Grid Background="{DynamicResource Dui.Surface.Content}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="{StaticResource Dui.Metrics.StatusBarRowHeight}" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="7"
                            Padding="10,7"
                            Background="{DynamicResource Banner.Error.Bg}"
                            BorderBrush="{DynamicResource Banner.Error.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Dui.Metrics.ControlRadius}"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource Banner.Error.Text}"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Ui.OverviewColumnWidth}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:DiffOverviewView Grid.Row="2" Grid.Column="0" />
                        <ContentControl x:Name="FormatContent" Grid.Row="2" Grid.Column="1" Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TextFormatTemplate}" />
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="{Binding DataContext.Preferences.ReadingScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ScaleY="{Binding DataContext.Preferences.ReadingScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditableText}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource EditableTextFormatTemplate}" />
                                            <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSpreadsheetView}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SpreadsheetFormatTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsWordView}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource WordFormatTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <Border x:Name="FindPanel" Grid.Row="0" Grid.ColumnSpan="2"
                                Padding="12,6" Background="{DynamicResource Dui.Surface.Toolbar}"
                                BorderBrush="{DynamicResource Dui.Border.Subtle}" BorderThickness="0,0,0,1"
                                Visibility="{Binding IsFindOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource Dui.CheckBox}" Margin="0,0,12,0" Content="{x:Static resources:Strings.MatchCase}" IsChecked="{Binding FindMatchCase}" />
                                    <CheckBox Style="{StaticResource Dui.CheckBox}" Content="{x:Static resources:Strings.FindDifferencesOnly}" IsChecked="{Binding FindDifferencesOnly}" />
                                    <TextBlock Margin="12,0,0,0" Width="74" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Dui.Text.Secondary}" Text="{Binding FindStatusText}" ToolTip="{Binding FindStatusText}" />
                                </StackPanel>
                                <Grid MinWidth="200">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="FindInput" Style="{StaticResource Dui.Input.TextBox}" Margin="0,0,7,0" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static resources:Strings.Find}" IsVisibleChanged="LocalInput_IsVisibleChanged" />
                                    <Button Grid.Column="1" Margin="0,0,4,0" Style="{StaticResource Dui.Button.Icon}"
                                            Command="{Binding FindPreviousCommand}" ToolTip="{x:Static resources:Strings.FindPrevious}">
                                    <dui:AppIcon Kind="Previous" />
                                </Button>
                                    <Button Grid.Column="2" Margin="0,0,4,0" Style="{StaticResource Dui.Button.Icon}"
                                            Command="{Binding FindNextCommand}" ToolTip="{x:Static resources:Strings.FindNext}">
                                    <dui:AppIcon Kind="Next" />
                                </Button>
                                    <Button Grid.Column="3" Style="{StaticResource Dui.Button.Icon}"
                                            Command="{Binding CloseFindCommand}" ToolTip="{x:Static resources:Strings.ClosePanel}">
                                    <dui:AppIcon Kind="Close" />
                                </Button>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border x:Name="GoToPanel" Grid.Row="1" Grid.ColumnSpan="2"
                                Padding="12,6" Background="{DynamicResource Dui.Surface.Toolbar}"
                                BorderBrush="{DynamicResource Dui.Border.Subtle}" BorderThickness="0,0,0,1"
                                Visibility="{Binding IsGoToOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Dui.Text.Secondary}" Text="{x:Static resources:Strings.GoToPrompt}" />
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" MaxWidth="180" VerticalAlignment="Center" Foreground="{DynamicResource Dui.Text.Secondary}" Text="{Binding LocationStatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationStatusText}" />
                                <Grid MinWidth="180" MaxWidth="360" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="GoToInput" Style="{StaticResource Dui.Input.TextBox}" Margin="0,0,7,0" Text="{Binding GoToText, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisibleChanged="LocalInput_IsVisibleChanged" />
                                    <Button Grid.Column="1" Margin="0,0,5,0" Style="{StaticResource Dui.Button.Toolbar}" MinWidth="55"
                                            Content="{x:Static resources:Strings.GoToAction}" Command="{Binding GoToCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource Dui.Button.Icon}"
                                            Command="{Binding CloseGoToCommand}" ToolTip="{x:Static resources:Strings.ClosePanel}">
                                    <dui:AppIcon Kind="Close" />
                                </Button>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ComparisonStatusBar" Grid.Row="2" Style="{StaticResource Dui.StatusBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <ProgressBar Width="84" Style="{StaticResource Dui.ProgressBar}"
                                             Height="6"
                                             Margin="0,0,9,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="{Binding IsBusy}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock VerticalAlignment="Center"
                                           ToolTip="{Binding SnapshotTimeText}"
                                           Foreground="{DynamicResource Dui.Text.Secondary}"
                                           FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                           TextTrimming="CharacterEllipsis"
                                           x:Name="EditorLocationStatus">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding StatusText}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsEditableText}" Value="True"><Setter Property="Text" Value="{Binding EditorLocationText}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <Border Grid.Column="1"
                                    Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Badge.Warning.Bg}"
                                    CornerRadius="{StaticResource Dui.Metrics.ControlRadius}"
                                    ToolTip="{Binding WarningToolTipText}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource Badge.Warning.Text}"
                                           FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                           Text="{Binding WarningSummaryText}" />
                            </Border>
                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Dui.Text.Secondary}"
                                       FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                       x:Name="EditorFormatStatus">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SummaryText}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsEditableText}" Value="True"><Setter Property="Text" Value="{Binding EditorFormatText}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Dui.Surface.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource Dui.Metrics.ToolbarRowHeight}" />
            <RowDefinition Height="Auto" MinHeight="{StaticResource Dui.Metrics.FileTabHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ComparisonToolbar" Grid.Row="0"
                Background="{DynamicResource Dui.Surface.Toolbar}"
                BorderBrush="{DynamicResource Dui.Border.Subtle}" BorderThickness="0,0,0,1">
            <Grid Margin="{StaticResource Dui.Metrics.PanePadding}" DataContext="{Binding SelectedTab}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="DisplayAllButton" GroupName="DisplayMode" Style="{StaticResource Dui.Radio.Segment}" MinWidth="44"
                                 Content="{x:Static resources:ChromeStrings.DisplayAll}" IsChecked="{Binding IsDisplayAll, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:ChromeStrings.DisplayAll}" ToolTip="{x:Static resources:Strings.DisplayAll}" />
                    <RadioButton x:Name="DisplayDifferencesButton" GroupName="DisplayMode" Style="{StaticResource Dui.Radio.Segment}" MinWidth="44" Margin="2,0,0,0"
                                 Content="{x:Static resources:ChromeStrings.DisplayDifferences}" IsChecked="{Binding IsDisplayDifferences, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:ChromeStrings.DisplayDifferences}" ToolTip="{x:Static resources:Strings.DisplayDifferences}" />
                    <RadioButton x:Name="DisplayContextButton" GroupName="DisplayMode" Style="{StaticResource Dui.Radio.Segment}" MinWidth="58" Margin="2,0,0,0"
                                 Content="{x:Static resources:ChromeStrings.DisplayContext}" IsChecked="{Binding IsDisplayContext, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:ChromeStrings.DisplayContext}" ToolTip="{x:Static resources:Strings.DisplayContext}" />
                </StackPanel>
                    <Border Grid.Column="1" x:Name="DifferenceNavigationGroup" VerticalAlignment="Center" Height="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                            Background="{DynamicResource Dui.Surface.Content}" BorderBrush="{DynamicResource Dui.Border.Subtle}"
                            BorderThickness="1,0" CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Dui.Button.Icon}" Command="{Binding PreviousDifferenceCommand}"
                                    AutomationProperties.Name="{x:Static resources:Strings.PreviousDifference}" ToolTip="{x:Static resources:Strings.PreviousDifferenceShortcut}">
                                    <dui:AppIcon Kind="Previous" />
                                </Button>
                            <TextBlock Width="84" Margin="2,0" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Dui.Text.Primary}" FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                       Text="{Binding DifferencePositionText}" ToolTip="{Binding DifferencePositionText}" />
                            <Button Style="{StaticResource Dui.Button.Icon}" Command="{Binding NextDifferenceCommand}"
                                    AutomationProperties.Name="{x:Static resources:Strings.NextDifference}" ToolTip="{x:Static resources:Strings.NextDifferenceShortcut}">
                                    <dui:AppIcon Kind="Next" />
                                </Button>
                        </StackPanel>
                    </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="FindButton" Style="{StaticResource Dui.Button.Toolbar}" MinWidth="92" Margin="0,0,4,0" Command="{Binding OpenFindCommand}"
                            AutomationProperties.Name="{x:Static resources:Strings.Find}" ToolTip="{x:Static resources:Strings.Find}">
                        <StackPanel Orientation="Horizontal">
                            <dui:AppIcon Kind="Search" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static resources:ChromeStrings.FindContent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Dui.Button.Icon}" Command="{Binding RefreshMineCommand}"
                            AutomationProperties.Name="{x:Static resources:Strings.RefreshMine}" ToolTip="{x:Static resources:Strings.RefreshMine}">
                                    <dui:AppIcon Kind="Refresh" />
                                </Button>
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource Dui.Button.Icon}" Click="ToggleTheme_Click"
                            AutomationProperties.Name="{x:Static resources:Strings.ToggleThemeShortcut}" ToolTip="{x:Static resources:Strings.ToggleThemeShortcut}">
                                    <dui:AppIcon Kind="Theme" />
                                </Button>
                    <Button x:Name="MoreActionsButton" Style="{StaticResource Dui.Button.Icon}"
                            AutomationProperties.Name="{x:Static resources:Strings.MoreActions}" ToolTip="{x:Static resources:Strings.MoreActions}" Click="ComparisonOptions_Click"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <dui:AppIcon Kind="More" />
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource Dui.ContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem x:Name="ComparisonRulesMenu" Header="{x:Static resources:ChromeStrings.AdvancedRules}" DataContext="{Binding SelectedTab}">

                                    <MenuItem IsHitTestVisible="False" Focusable="False">
                                        <MenuItem.Header><TextBlock MaxWidth="300" Foreground="{DynamicResource Dui.Text.Secondary}" TextWrapping="Wrap" Text="{Binding Options.ActiveRulesSummary}" /></MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.IgnoreWhitespace}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding Options.IgnoreWhitespace}" Visibility="{Binding Options.SupportsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{x:Static resources:Strings.IgnoreCase}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding Options.IgnoreCase}" Visibility="{Binding Options.SupportsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{x:Static resources:Strings.IgnoreLineEndings}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding Options.IgnoreLineEndings}" Visibility="{Binding Options.SupportsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{x:Static resources:Strings.CompareFormatting}" IsCheckable="True" StaysOpenOnClick="True"
                                              IsChecked="{Binding Options.CompareFormatting}" Visibility="{Binding Options.SupportsFormatting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{Binding Options.EncodingLabel}" Visibility="{Binding Options.SupportsEncoding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <MenuItem Header="{x:Static resources:Strings.AutomaticEncoding}" Command="{Binding Options.SetEncodingCommand}" CommandParameter="" StaysOpenOnClick="True" />
                                        <MenuItem Header="UTF-8" Command="{Binding Options.SetEncodingCommand}" CommandParameter="utf-8" StaysOpenOnClick="True" />
                                        <MenuItem Header="UTF-16 LE" Command="{Binding Options.SetEncodingCommand}" CommandParameter="utf-16" StaysOpenOnClick="True" />
                                        <MenuItem Header="UTF-16 BE" Command="{Binding Options.SetEncodingCommand}" CommandParameter="utf-16BE" StaysOpenOnClick="True" />
                                        <MenuItem Header="GB18030 / GBK" Command="{Binding Options.SetEncodingCommand}" CommandParameter="gb18030" StaysOpenOnClick="True" />
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True" Focusable="False"
                                              Visibility="{Binding Options.SupportsKeyColumns, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <MenuItem.Header>
                                            <StackPanel Width="260" Margin="0,4">
                                                <TextBlock Margin="0,0,0,5" Text="{x:Static resources:Strings.KeyColumns}" />
                                                <TextBox Style="{StaticResource Dui.Input.TextBox}" Text="{Binding Options.KeyColumnsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static resources:Strings.KeyColumnsHint}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.ApplyComparisonOptions}" Command="{Binding ApplyOptionsCommand}" />
                                    <MenuItem Header="{x:Static resources:Strings.SpreadsheetRulesTitle}" Click="EditSpreadsheetRules_Click"
                                              Visibility="{Binding Options.SupportsSpreadsheetRules, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{x:Static resources:Strings.SaveRules}" Command="{Binding SaveRulesCommand}" />
                                    <MenuItem Header="{x:Static resources:Strings.RestoreRules}" Command="{Binding RestoreRulesCommand}" />

                                </MenuItem>
                                <Separator />

                                    <MenuItem Header="{x:Static resources:Strings.GoTo}" Command="{Binding SelectedTab.OpenGoToCommand}" />
                                    <Separator />
                                    <MenuItem IsHitTestVisible="False" Focusable="False">
                                        <MenuItem.Header>
                                            <TextBlock Text="{Binding Preferences.ReadingScale, StringFormat={}{0:P0}}" />
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resources:Strings.ZoomIn}" Click="ZoomIn_Click" />
                                    <MenuItem Header="{x:Static resources:Strings.ZoomOut}" Click="ZoomOut_Click" />
                                    <MenuItem Header="{x:Static resources:Strings.ZoomReset}" Click="ZoomReset_Click" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.ExportHtml}" Click="ExportHtml_Click" IsEnabled="{Binding SelectedTab.CanExport}" />
                                    <MenuItem Header="{x:Static resources:Strings.ExportSelectedText}" Click="ExportSelectedText_Click" IsEnabled="{Binding SelectedTab.CanExport}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.SaveRules}" Command="{Binding SelectedTab.SaveRulesCommand}" />
                                    <MenuItem Header="{x:Static resources:Strings.RestoreRules}" Command="{Binding SelectedTab.RestoreRulesCommand}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static resources:Strings.FilterTabs}" Click="FilterTabs_Click" />
                                    <MenuItem Header="{x:Static resources:Strings.CloseOtherTabs}" Command="{Binding CloseOtherTabsCommand}" />
                                    <MenuItem Header="{x:Static resources:Strings.CloseAllTabs}" Command="{Binding CloseAllTabsCommand}" />

                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Background="{DynamicResource Dui.Surface.Tabs}"
                BorderBrush="{DynamicResource Dui.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ListBox x:Name="FileTabs" Background="Transparent"
                         Padding="0"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource FileTabItemStyle}"
                         ItemsSource="{Binding VisibleTabs}"
                         SelectionChanged="FileTabs_SelectionChanged"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18"
                                        Height="18"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Dui.State.Hover}"
                                        CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Dui.Text.Secondary}"
                                               FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                               FontWeight="SemiBold"
                                               Text="{Binding FileKindGlyph}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FileName}" />
                                <Border Grid.Column="2"
                                        MinWidth="16"
                                        Margin="0,0,6,0"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Visibility="{Binding HasChromeTabBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Dui.Text.Secondary}"
                                               FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                               Text="{Binding ChromeTabBadge}" />
                                </Border>
                                <Button Grid.Column="3"
                                        Style="{StaticResource Dui.Button.Icon}"
                                        Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                        Height="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding CloseTabCommand}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        AutomationProperties.Name="{x:Static resources:Strings.CloseTab}"
                                        ToolTip="{x:Static resources:Strings.CloseTab}">
                                    <dui:AppIcon Kind="Close" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="FilterTabsButton" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Dui.Button.Icon}"
                        ToolTip="{x:Static resources:Strings.FilterTabs}" AutomationProperties.Name="{x:Static resources:Strings.FilterTabs}" Click="FilterTabs_Click">
                    <dui:AppIcon Kind="Filter" />
                </Button>
                <Popup x:Name="TabFilterPopup" PlacementTarget="{Binding ElementName=FilterTabsButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                    <Border Width="310" Margin="0,4,0,0" Padding="12" Style="{StaticResource Dui.Popup}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,7" Text="{x:Static resources:Strings.FilterTabs}" />
                            <TextBox x:Name="TabFilterInput" Style="{StaticResource Dui.Input.TextBox}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     IsVisibleChanged="LocalInput_IsVisibleChanged" PreviewKeyDown="FilterInput_PreviewKeyDown" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <controls:PersistentContentHost x:Name="ComparisonContentHost"
                                        Grid.Row="2"
                                        Background="{DynamicResource Dui.Surface.Content}"
                                        ContentTemplate="{StaticResource ComparisonContentTemplate}"
                                        ItemsSource="{Binding Tabs}"
                                        SelectedItem="{Binding SelectedTab}"
                                        TraceCategory="file-tab-switch" />
    </Grid>
</Window>
