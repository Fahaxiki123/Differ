    <SolidColorBrush x:Key="Sample.SwitchThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sample.SelectionBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="Sample.InactiveSelectionBrush" Color="#EFEFF4" />
    <SolidColorBrush x:Key="Sample.LineNumberBrush" Color="#686A73" />
    <SolidColorBrush x:Key="Sample.ScrollThumbBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="Sample.ScrollHoverBrush" Color="#AEAEB2" />
    <SolidColorBrush x:Key="Sample.ScrollPressedBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="Sample.IndentBrush" Color="#EFEFF4" />
    <SolidColorBrush x:Key="Sample.MissingBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Editor.Selection" Color="#E5E5EA" />
    <SolidColorBrush x:Key="Editor.InactiveSelection" Color="#EFEFF4" />
    <SolidColorBrush x:Key="Editor.Indent" Color="#ECEEF2" />
    <SolidColorBrush x:Key="Editor.Missing" Color="#F5F6F8" />
