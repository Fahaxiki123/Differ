<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Differ.UI;component/Themes/Light.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Key="Theme.Name">Light</sys:String>

    <!-- Chrome surfaces and text -->
    <Color x:Key="Canvas.Color">#EBECEE</Color>
    <Color x:Key="Panel.Color">#FFFFFF</Color>
    <Color x:Key="Ink.Color">#1D1D1F</Color>
    <Color x:Key="MutedInk.Color">#6E6E73</Color>
    <Color x:Key="Border.Color">#DFE1E6</Color>
    <Color x:Key="Accent.Color">#1D1D1F</Color>
    <Color x:Key="AccentHover.Color">#2C2C2E</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Canvas.Color}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel.Color}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink.Color}" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInk.Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border.Color}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover.Color}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Window / toolbar / tab / status chrome greys -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EBECEE" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#EBECEE" />
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#DFE1E6" />
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#EBECEE" />
    <SolidColorBrush x:Key="TabStripBorderBrush" Color="#DFE1E6" />
    <SolidColorBrush x:Key="TabRestBrush" Color="#00EBECEE" />
    <SolidColorBrush x:Key="TabRestBorderBrush" Color="#00EBECEE" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#E2E4E9" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabSelectedBorderBrush" Color="#D5D8E0" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#E5E6EB" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="PaneHeaderBackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="PaneSeparatorBrush" Color="#E5E6EB" />
    <SolidColorBrush x:Key="GutterBackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="GutterTextBrush" Color="#686A73" />
    <SolidColorBrush x:Key="DetailBackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="TextRowSeparatorBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="#0A1D1D1F" />
    <SolidColorBrush x:Key="PaneHeaderBorderBrush" Color="#E5E6EB" />
    <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#00EBECEE" />
    <SolidColorBrush x:Key="ToolbarButtonTextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#00EBECEE" />
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#E2E4E9" />
    <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#D8DBE2" />
    <SolidColorBrush x:Key="Toolbar.SelectedBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Toolbar.SelectedBorderBrush" Color="#D5D8E0" />
    <SolidColorBrush x:Key="Toolbar.SelectedTextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="BaseSideAccentBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="MineSideAccentBrush" Color="#1D1D1F" />

    <!-- Integration page surfaces and semantic banners -->
    <SolidColorBrush x:Key="MainWindow.HeaderBg" Color="#1D1D1F" />
    <SolidColorBrush x:Key="MainWindow.HeaderText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MainWindow.HeaderSubtext" Color="#C8CDD5" />
    <SolidColorBrush x:Key="MainWindow.InfoBg" Color="#EEF3FA" />
    <SolidColorBrush x:Key="MainWindow.InfoBorder" Color="#C7D5E9" />
    <SolidColorBrush x:Key="MainWindow.InfoText" Color="#315E9D" />
    <SolidColorBrush x:Key="MainWindow.ErrorBg" Color="#FFF5F5" />
    <SolidColorBrush x:Key="MainWindow.ErrorBorder" Color="#E6BEC3" />
    <SolidColorBrush x:Key="MainWindow.ErrorText" Color="#C92A2A" />
    <SolidColorBrush x:Key="MainWindow.WarningBg" Color="#FFF9EB" />
    <SolidColorBrush x:Key="MainWindow.WarningBorder" Color="#E6D7B4" />
    <SolidColorBrush x:Key="MainWindow.WarningText" Color="#B45309" />
    <SolidColorBrush x:Key="MainWindow.SuccessBg" Color="#F2FBF5" />
    <SolidColorBrush x:Key="MainWindow.SuccessBorder" Color="#C4DECD" />
    <SolidColorBrush x:Key="MainWindow.SuccessText" Color="#2B8A3E" />

    <!-- Toolbar chips, counters and file-tab decorations -->
    <SolidColorBrush x:Key="Toolbar.ChipBackgroundBrush" Color="#E2E4E9" />
    <SolidColorBrush x:Key="Toolbar.ChipBorderBrush" Color="#D5D8E0" />
    <SolidColorBrush x:Key="Toolbar.ChipTextBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="Toolbar.BadgeBackgroundBrush" Color="#E2E4E9" />
    <SolidColorBrush x:Key="Toolbar.BadgeBorderBrush" Color="#D5D8E0" />
    <SolidColorBrush x:Key="Toolbar.CounterBackgroundBrush" Color="#E2E4E9" />

    <!-- Status-bar warning badge and blocking error banner -->
    <SolidColorBrush x:Key="Badge.Warning.Bg" Color="#FFF9EB" />
    <SolidColorBrush x:Key="Badge.Warning.Text" Color="#B45309" />
    <SolidColorBrush x:Key="Banner.Error.Bg" Color="#FFF5F5" />
    <SolidColorBrush x:Key="Banner.Error.Border" Color="#E6BEC3" />
    <SolidColorBrush x:Key="Banner.Error.Text" Color="#C92A2A" />
    <SolidColorBrush x:Key="Toolbar.CounterBorderBrush" Color="#D5D8E0" />
    <SolidColorBrush x:Key="FileTab.TextBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="FileTab.IconBackgroundBrush" Color="#00EBECEE" />
    <SolidColorBrush x:Key="FileTab.BadgeBackgroundBrush" Color="#00EBECEE" />

    <!-- ScrollBar modern template (no arrow buttons, rounded track and thumb) -->
    <SolidColorBrush x:Key="ScrollBar.TrackBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBar.ThumbBrush" Color="#C6CAD1" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHoverBrush" Color="#ADB3BC" />
    <SolidColorBrush x:Key="ScrollBar.ThumbPressedBrush" Color="#8E98A5" />

    <!-- Standard control chrome (Button / TextBox / DataGrid in App.xaml) -->
    <SolidColorBrush x:Key="Control.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Control.Hover" Color="#E2E4E9" />
    <SolidColorBrush x:Key="Control.Pressed" Color="#D8DBE2" />
    <SolidColorBrush x:Key="DataGrid.GridLine" Color="#ECEEF2" />
    <SolidColorBrush x:Key="DataGrid.Header.Bg" Color="#FAFAFC" />

    <!-- Semantic diff row backgrounds and status-bar borders (DiffWindow) -->
    <SolidColorBrush x:Key="Diff.Row.Added.Bg" Color="#F1F9F3" />
    <SolidColorBrush x:Key="Diff.Row.Added.Border" Color="#2B8A3E" />
    <SolidColorBrush x:Key="Diff.Row.Deleted.Bg" Color="#FEF4F4" />
    <SolidColorBrush x:Key="Diff.Row.Deleted.Border" Color="#C92A2A" />
    <SolidColorBrush x:Key="Diff.Row.Modified.Bg" Color="#FFF9EB" />
    <SolidColorBrush x:Key="Diff.Row.Modified.Border" Color="#B45309" />
    <SolidColorBrush x:Key="Diff.Row.Moved.Bg" Color="#EBF1FA" />
    <SolidColorBrush x:Key="Diff.Row.Moved.Border" Color="#356BC4" />
    <SolidColorBrush x:Key="Diff.Row.Conflict.Bg" Color="#FBEBDC" />
    <SolidColorBrush x:Key="Diff.Row.Conflict.Border" Color="#A44820" />
    <SolidColorBrush x:Key="Diff.Row.Unsupported.Bg" Color="#F0EAF7" />
    <SolidColorBrush x:Key="Diff.Row.Unsupported.Border" Color="#765095" />

    <!-- Text view asymmetric cell backgrounds -->
    <SolidColorBrush x:Key="Diff.TextCell.Base.Added" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Diff.TextCell.Base.Deleted" Color="#FFF5F5" />
    <SolidColorBrush x:Key="Diff.TextCell.Base.Modified" Color="#FFF9EB" />
    <SolidColorBrush x:Key="Diff.TextCell.Mine.Added" Color="#F2FBF5" />
    <SolidColorBrush x:Key="Diff.TextCell.Mine.Deleted" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Diff.TextCell.Mine.Modified" Color="#FFF9EB" />

    <!-- Spreadsheet cell backgrounds -->
    <SolidColorBrush x:Key="Diff.Cell.Added" Color="#F1F9F3" />
    <SolidColorBrush x:Key="Diff.Cell.Deleted" Color="#FEF4F4" />
    <SolidColorBrush x:Key="Diff.Cell.Modified" Color="#FFF9EB" />
    <SolidColorBrush x:Key="Diff.Cell.Moved" Color="#EBF1FA" />
    <SolidColorBrush x:Key="Diff.Cell.Conflict" Color="#FBEBDC" />
    <SolidColorBrush x:Key="Diff.Cell.Unsupported" Color="#F0EAF7" />

    <!-- Word pane backgrounds (asymmetric) -->
    <SolidColorBrush x:Key="Diff.WordPane.Base.Added" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Diff.WordPane.Mine.Added" Color="#F2FBF5" />
    <SolidColorBrush x:Key="Diff.WordPane.Base.Deleted" Color="#FFF5F5" />
    <SolidColorBrush x:Key="Diff.WordPane.Mine.Deleted" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Diff.WordPane.Modified" Color="#FFF9EB" />
    <SolidColorBrush x:Key="Diff.WordPane.Moved" Color="#EBF1FA" />
    <SolidColorBrush x:Key="Diff.WordPane.Conflict" Color="#FBEBDC" />
    <SolidColorBrush x:Key="Diff.WordPane.Unsupported" Color="#F0EAF7" />

    <!-- Word footer summaries -->
    <SolidColorBrush x:Key="Word.Summary.BaseBg" Color="#FAFAFC" />
    <SolidColorBrush x:Key="Word.Summary.BaseBorder" Color="#E5E6EB" />
    <SolidColorBrush x:Key="Word.Summary.BaseText" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Word.Summary.MineBg" Color="#FAFAFC" />
    <SolidColorBrush x:Key="Word.Summary.MineBorder" Color="#E5E6EB" />
    <SolidColorBrush x:Key="Word.Summary.MineText" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Word.Summary.Separator" Color="#E5E6EB" />

    <!-- Inline (character-level) foreground emphasis -->
    <Color x:Key="Diff.Inline.Added.Color">#23713A</Color>
    <Color x:Key="Diff.Inline.Modified.Color">#B45309</Color>
    <Color x:Key="Diff.Inline.Deleted.Color">#C92A2A</Color>
    <Color x:Key="Diff.Inline.Moved.Color">#315E9D</Color>
    <Color x:Key="Diff.Inline.Conflict.Color">#9A431E</Color>
    <Color x:Key="Diff.Inline.WordAdded.Color">#23713A</Color>

    <SolidColorBrush x:Key="Diff.Inline.Added.Brush" Color="{StaticResource Diff.Inline.Added.Color}" />
    <SolidColorBrush x:Key="Diff.Inline.Modified.Brush" Color="{StaticResource Diff.Inline.Modified.Color}" />
    <SolidColorBrush x:Key="Diff.Inline.Deleted.Brush" Color="{StaticResource Diff.Inline.Deleted.Color}" />
    <SolidColorBrush x:Key="Diff.Inline.Moved.Brush" Color="{StaticResource Diff.Inline.Moved.Color}" />
    <SolidColorBrush x:Key="Diff.Inline.Conflict.Brush" Color="{StaticResource Diff.Inline.Conflict.Color}" />
    <SolidColorBrush x:Key="Diff.Inline.WordAdded.Brush" Color="{StaticResource Diff.Inline.WordAdded.Color}" />

    <!-- Overview minimap -->
    <SolidColorBrush x:Key="Diff.Overview.ViewportBrush" Color="#161D1D1F" />
    <SolidColorBrush x:Key="Diff.Overview.ViewportBorderBrush" Color="#501D1D1F" />
    <SolidColorBrush x:Key="Diff.Rail.Divider" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Diff.Rail.Band" Color="#101D1D1F" />
    <SolidColorBrush x:Key="Diff.Rail.BandHover" Color="#181D1D1F" />
    <SolidColorBrush x:Key="Diff.Rail.Edge" Color="#551D1D1F" />
    <SolidColorBrush x:Key="Diff.Overview.PreviewBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Diff.Overview.PreviewBorderBrush" Color="#DFE1E6" />
    <Color x:Key="Diff.Overview.Shadow.Color">#000000</Color>
    <Color x:Key="Diff.Overview.Unchanged.Color">#00FFFFFF</Color>
    <Color x:Key="Diff.Overview.Added.Color">#2B8A3E</Color>
    <Color x:Key="Diff.Overview.Deleted.Color">#C92A2A</Color>
    <Color x:Key="Diff.Overview.Modified.Color">#D97706</Color>
    <Color x:Key="Diff.Overview.Moved.Color">#356BC4</Color>
    <Color x:Key="Diff.Overview.Conflict.Color">#C48053</Color>
    <Color x:Key="Diff.Overview.Unsupported.Color">#A18AB8</Color>
    <Color x:Key="Diff.Overview.Hover.Color">#E2E4E9</Color>
    <Color x:Key="Diff.Overview.HoverPen.Color">#1D1D1F</Color>
    <SolidColorBrush x:Key="Diff.Overview.Unchanged.Brush" Color="{StaticResource Diff.Overview.Unchanged.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Added.Brush" Color="{StaticResource Diff.Overview.Added.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Deleted.Brush" Color="{StaticResource Diff.Overview.Deleted.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Modified.Brush" Color="{StaticResource Diff.Overview.Modified.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Moved.Brush" Color="{StaticResource Diff.Overview.Moved.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Conflict.Brush" Color="{StaticResource Diff.Overview.Conflict.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.Unsupported.Brush" Color="{StaticResource Diff.Overview.Unsupported.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.HoverBrush" Color="{StaticResource Diff.Overview.Hover.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.HoverPenBrush" Color="{StaticResource Diff.Overview.HoverPen.Color}" />
    <SolidColorBrush x:Key="Diff.Overview.BackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="Diff.Overview.BorderBrush" Color="#E5E6EB" />
    <!-- Floating surfaces alone receive a shadow. -->
    <Color x:Key="Popup.Shadow.Color">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Popup.Shadow.Opacity">0.12</sys:Double>
    <!-- Text comparison sample tokens -->
    <SolidColorBrush x:Key="Sample.ToolbarBrush" Color="#EBECEE" />
    <SolidColorBrush x:Key="Sample.PaneHeaderBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="Sample.TabStripBrush" Color="#EBECEE" />
    <SolidColorBrush x:Key="Sample.SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sample.BorderBrush" Color="#DFE1E6" />
    <SolidColorBrush x:Key="Sample.AccentBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Sample.AccentHoverBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Sample.AccentPressedBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="Sample.InkBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Sample.MutedInkBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="Sample.SelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Sample.HoverBrush" Color="#E2E4E9" />
