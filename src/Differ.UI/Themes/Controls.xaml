<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:Differ.UI.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The focus adorner keeps all hit targets and layout sizes stable. -->
    <Style x:Key="Dui.KeyboardFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border IsHitTestVisible="False" Margin="-2" BorderThickness="2"
                            CornerRadius="{StaticResource Dui.Metrics.ControlRadius}"
                            BorderBrush="{DynamicResource Dui.Focus}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Dui.CommandTemplate" TargetType="ButtonBase">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                CornerRadius="{StaticResource Dui.Metrics.ControlRadius}" SnapsToDevicePixels="True">
            <ContentPresenter RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Dui.Button.Base" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.BodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.ButtonPadding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="Template" Value="{StaticResource Dui.CommandTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Dui.State.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.Button.Primary" TargetType="Button" BasedOn="{StaticResource Dui.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Dui.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.Accent.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.Accent.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Dui.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Content}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Control}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.Button.Quiet" TargetType="Button" BasedOn="{StaticResource Dui.Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.Button.Danger" TargetType="Button" BasedOn="{StaticResource Dui.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Dui.Danger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.OnDanger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.Danger.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.Danger.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Dui.Button.Quiet}">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ToolbarButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource Dui.Metrics.ToolbarButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.ToolbarButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.SecondaryFontSize}" />
    </Style>
    <Style x:Key="Dui.Button.Icon" TargetType="Button" BasedOn="{StaticResource Dui.Button.Toolbar}">
        <Setter Property="Width" Value="{StaticResource Dui.Metrics.ToolbarIconButtonWidth}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Dui.Toggle.Segment" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.SecondaryFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ToolbarButtonHeight}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.ToolbarButtonPadding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="Template" Value="{StaticResource Dui.CommandTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Dui.Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Dui.State.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.Radio.Segment" TargetType="RadioButton" BasedOn="{StaticResource Dui.Toggle.Segment}" />


    <Style x:Key="Dui.CheckBox" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ControlHeight}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="{StaticResource Dui.Metrics.IconSize}"
                                Height="{StaticResource Dui.Metrics.IconSize}" VerticalAlignment="Center"
                                Background="{DynamicResource Dui.Surface.Content}"
                                BorderBrush="{DynamicResource Dui.Border.Control}" BorderThickness="1"
                                CornerRadius="{StaticResource Dui.Metrics.SmallRadius}">
                            <Grid>
                                <icons:AppIcon x:Name="Check" Kind="Check" Size="12" Visibility="Collapsed"
                                               Foreground="{DynamicResource Dui.Text.OnAccent}" />
                                <icons:AppIcon x:Name="Mixed" Kind="Remove" Size="12" Visibility="Collapsed"
                                               Foreground="{DynamicResource Dui.Text.OnAccent}" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Dui.Focus}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dui.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dui.Toggle.Switch" TargetType="ToggleButton" BasedOn="{StaticResource Dui.Toggle.Segment}">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="24" Height="14" Margin="0,0,6,0"
                                    BorderBrush="{DynamicResource Dui.Border.Control}" BorderThickness="1"
                                    Background="{DynamicResource Dui.Surface.Content}" CornerRadius="7">
                                <Ellipse x:Name="Thumb" Width="8" Height="8" Margin="2,0"
                                         HorizontalAlignment="Left" Fill="{DynamicResource Dui.Text.Secondary}" />
                            </Border>
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Dui.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Dui.Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dui.Input.Base" TargetType="Control">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.InputPadding}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Content}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Focus}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Status.Error}" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Dui.State.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.Input.TextBox" TargetType="TextBox" BasedOn="{StaticResource Dui.Input.Base}">
        <Setter Property="SelectionBrush" Value="{DynamicResource Dui.State.Selected}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Dui.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsReadOnly" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.ReadOnly}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.InputPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Dui.Metrics.SmallRadius}">
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Focus}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.Input.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource Dui.Input.Base}">
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Dui.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2"
                                          Focusable="False" IsTabStop="False" ClickMode="Press"
                                          Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource Dui.Metrics.ControlRadius}">
                                            <icons:AppIcon Kind="ChevronDown" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsEnabled" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dui.State.Hover}" />
                                            </MultiTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Dui.State.Pressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border Grid.Column="1" Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter x:Name="Selection" Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                     Style="{StaticResource Dui.Input.TextBox}" Padding="{TemplateBinding Padding}"
                                     Background="Transparent" BorderThickness="0" MinHeight="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Style="{DynamicResource Dui.Popup}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsReadOnly" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Dui.State.ReadOnly}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- Native panels retain WPF command routing, overflow priority and keyboard behavior. -->
    <Style x:Key="Dui.ToolBar" TargetType="ToolBar">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Toolbar}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <DockPanel KeyboardNavigation.TabNavigation="Local">
                                <ToggleButton x:Name="OverflowButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                              Style="{StaticResource Dui.Toggle.Segment}"
                                              Width="{StaticResource Dui.Metrics.ToolbarButtonHeight}" Padding="0"
                                              IsEnabled="{TemplateBinding HasOverflowItems}"
                                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              AutomationProperties.Name="{StaticResource Dui.ToolBar.OverflowLabel}">
                                    <icons:AppIcon Kind="More" />
                                </ToggleButton>
                                <Thumb x:Name="ToolBarThumb" Focusable="False" DockPanel.Dock="Left" Width="8"
                                       Background="{DynamicResource Dui.Border.Subtle}" />
                                <ContentPresenter x:Name="ToolBarHeader" ContentSource="Header" DockPanel.Dock="Left"
                                                  VerticalAlignment="Center" />
                                <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="OverflowPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowButton}"
                               AllowsTransparency="True" StaysOpen="False" Focusable="False"
                               IsOpen="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Style="{DynamicResource Dui.Popup}">
                                <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="240" Focusable="True"
                                                      KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowItems" Value="False">
                            <Setter TargetName="OverflowButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ToolBarTray.IsLocked" Value="True">
                            <Setter TargetName="ToolBarThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="ToolBarHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="MinWidth" Value="{StaticResource Dui.Metrics.ToolbarHeight}" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter TargetName="OverflowButton" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="OverflowPopup" Property="Placement" Value="Right" />
                            <Setter TargetName="ToolBarHeader" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="ToolBarThumb" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="ToolBarThumb" Property="Width" Value="Auto" />
                            <Setter TargetName="ToolBarThumb" Property="Height" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dui.Tab" TargetType="TabItem">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.FileTabHeight}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.ButtonPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Tabs}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Dui.Metrics.TabRadius}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.Surface.Content}" />
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dui.PaneHeader" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.PaneHeaderHeight}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.PaneHeader}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.PanePadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="Dui.StatusBar" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource Dui.Metrics.StatusBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Status}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.PanePadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="Dui.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Content}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.PopupPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource Dui.Metrics.PopupRadius}" />
    </Style>

    <Style x:Key="Dui.MenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.InputPadding}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource Dui.MenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Dui.Metrics.SmallRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="Mark" Width="{StaticResource Dui.Metrics.IconSize}" Margin="0,0,8,0">
                                <ContentPresenter x:Name="ItemIcon" ContentSource="Icon" VerticalAlignment="Center" />
                                <icons:AppIcon x:Name="CheckMark" Kind="Check" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       FontSize="{StaticResource Dui.Metrics.SecondaryFontSize}"
                                       Foreground="{DynamicResource Dui.Text.Secondary}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <icons:AppIcon x:Name="SubmenuArrow" Grid.Column="3" Kind="ChevronRight"
                                           Margin="8,0,0,0" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Right" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}" PlacementTarget="{Binding ElementName=Chrome}">
                                <Border Style="{StaticResource Dui.Popup}" MaxWidth="{StaticResource Dui.Metrics.PopupMaxWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        KeyboardNavigation.TabNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelHeader" />
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelItem" />
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.State.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.Menu" TargetType="Menu">
        <Style.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource Dui.MenuItem}" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Toolbar}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
    </Style>
    <Style x:Key="Dui.ContextMenu" TargetType="ContextMenu">
        <Style.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource Dui.MenuItem}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Style="{StaticResource Dui.Popup}" MaxWidth="{StaticResource Dui.Metrics.PopupMaxWidth}">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dui.ToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.SecondaryFontSize}" />
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.TooltipPadding}" />
        <Setter Property="MaxWidth" Value="{StaticResource Dui.Metrics.PopupMaxWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Style="{StaticResource Dui.Popup}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dui.Dialog" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Dui.Metrics.UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource Dui.Metrics.BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Window}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Dui.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Dui.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Dui.State.ReadOnly}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Dui.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="6" />
    </Style>
    <Style x:Key="Dui.EmptyState" TargetType="ContentControl">
        <Setter Property="Padding" Value="{StaticResource Dui.Metrics.DialogPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource Dui.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Content}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dui.GridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Dui.Border.Subtle}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Dui.KeyboardFocus}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.Border.Control}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="Dui.ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Dui.Scroll.Thumb}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="1" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Dui.Metrics.SmallRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.Scroll.ThumbHover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource Dui.Scroll.ThumbPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Dui.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dui.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Dui.Surface.Status}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="{StaticResource Dui.Metrics.ScrollBarSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Dui.ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Dui.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Dui.ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="{StaticResource Dui.Metrics.ScrollBarSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Dui.ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Dui.ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Dui.ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
