<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Dui.Color.Accent">#F5F5F7</Color>
    <SolidColorBrush x:Key="Dui.Surface.Window" Color="#111215" />
    <SolidColorBrush x:Key="Dui.Surface.Content" Color="#17181C" />
    <SolidColorBrush x:Key="Dui.Surface.Toolbar" Color="#111215" />
    <SolidColorBrush x:Key="Dui.Surface.Tabs" Color="#111215" />
    <SolidColorBrush x:Key="Dui.Surface.PaneHeader" Color="#1A1C21" />
    <SolidColorBrush x:Key="Dui.Surface.Status" Color="#141519" />
    <SolidColorBrush x:Key="Dui.Text.Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Dui.Text.Secondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Dui.Text.OnAccent" Color="#111215" />
    <SolidColorBrush x:Key="Dui.Text.Disabled" Color="#71717A" />
    <SolidColorBrush x:Key="Dui.Border.Subtle" Color="#272930" />
    <SolidColorBrush x:Key="Dui.Border.Control" Color="#787A84" />
    <SolidColorBrush x:Key="Dui.Accent" Color="{StaticResource Dui.Color.Accent}" />
    <SolidColorBrush x:Key="Dui.Accent.Hover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Dui.Accent.Pressed" Color="#D1D1D6" />
    <SolidColorBrush x:Key="Dui.Focus" Color="{StaticResource Dui.Color.Accent}" />
    <SolidColorBrush x:Key="Dui.State.Hover" Color="#23252C" />
    <SolidColorBrush x:Key="Dui.State.Pressed" Color="#2C2F38" />
    <SolidColorBrush x:Key="Dui.State.Selected" Color="#282A32" />
    <SolidColorBrush x:Key="Dui.State.Disabled" Color="#1E2026" />
    <SolidColorBrush x:Key="Dui.State.ReadOnly" Color="#1E2026" />
    <SolidColorBrush x:Key="Dui.Status.Info" Color="#AFCAFF" />
    <SolidColorBrush x:Key="Dui.Status.InfoSurface" Color="#263650" />
    <SolidColorBrush x:Key="Dui.Status.Warning" Color="#F2CC7D" />
    <SolidColorBrush x:Key="Dui.Status.WarningSurface" Color="#402F16" />
    <SolidColorBrush x:Key="Dui.Status.Error" Color="#FFB2BC" />
    <SolidColorBrush x:Key="Dui.Status.ErrorSurface" Color="#4A242D" />
    <SolidColorBrush x:Key="Dui.Danger" Color="#FFB2BC" />
    <SolidColorBrush x:Key="Dui.Danger.Hover" Color="#FFD0D5" />
    <SolidColorBrush x:Key="Dui.Danger.Pressed" Color="#F297A5" />
    <SolidColorBrush x:Key="Dui.Text.OnDanger" Color="#291A1E" />
    <SolidColorBrush x:Key="Dui.Scroll.Thumb" Color="#52525B" />
    <SolidColorBrush x:Key="Dui.Scroll.ThumbHover" Color="#71717A" />
    <SolidColorBrush x:Key="Dui.Scroll.ThumbPressed" Color="#A1A1AA" />
</ResourceDictionary>
