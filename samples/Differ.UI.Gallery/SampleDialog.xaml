<Window x:Class="Differ.UI.Gallery.SampleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dui="clr-namespace:Differ.UI.Controls;assembly=Differ.UI"
        Style="{StaticResource Dui.Dialog}"
        Title="示例确认"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}">
    <Border Padding="{StaticResource Dui.Metrics.DialogPadding}" Background="{DynamicResource Dui.Surface.Content}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <dui:AppIcon Kind="Info" Size="{StaticResource Dui.Metrics.IconSizeLarge}"
                             Foreground="{DynamicResource Dui.Status.Info}" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource Gallery.SectionHeading}" Text="确认示例操作？" />
            </StackPanel>
            <TextBlock Text="这是 Gallery 的独立对话框。确认只会更新组件预览的状态栏。"
                       Style="{StaticResource Gallery.Caption}" />
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Dui.Button.Secondary}" Content="取消" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Dui.Button.Primary}" Content="确认" IsDefault="True"
                        Click="OnConfirm" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
