# Preserve existing Windows source conventions on checkout.
* text=auto
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.ps1 text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.resx text eol=crlf
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.woff binary
*.ttf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
