# Preserve existing Windows source conventions on checkout.
* text=auto
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.sln text eol=crlf
*.ps1 text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.resx text eol=crlf
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.woff binary
*.ttf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
# Release licence checks pin exact upstream bytes, including LF/mixed line endings.
docs/third-party/Microsoft.Extensions-10.0.10-LICENSE.txt binary !eol
docs/third-party/NPOI-2.7.4-LICENSE binary !eol
docs/third-party/Microsoft.Web.WebView2-1.0.3537.50-LICENSE.txt binary !eol
docs/third-party/Microsoft.Web.WebView2-1.0.3537.50-NOTICE.txt binary !eol
docs/third-party/Monaco-0.52.2-LICENSE.txt binary !eol
docs/third-party/SharpSvn-1.14005.390-LICENSE.txt binary !eol
docs/third-party/Microsoft-Visual-Studio-2026-REDIST-LICENSE.txt binary !eol
